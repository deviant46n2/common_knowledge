          "@id": "https://example.org/ck/source/csv"
        },
        "oa:hasSelector": {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "R-1,2026-05-01T09:00:00Z,dissolved_oxygen,4.2,mg/L",
          "oa:prefix": "station_id,timestamp,parameter,value,unit\n",
          "oa:suffix": "\nR-1,2026-05-01T10:00:00Z,dissolved_oxygen,4.0,mg/L"
        }
      }
    },
    {
      "@id": "https://example.org/ck/evidence/calibration-entry-2",
