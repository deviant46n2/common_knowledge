        "@type": "oa:SpecificResource",
        "oa:hasSource": {
          "@id": "https://example.org/ck/source/calibration"
        },
        "oa:hasSelector": {
          "@type": "oa:TextQuoteSelector",
          "oa:exact": "2026-04-20 | Calibration due | Not completed",
          "oa:prefix": "2026-01-20 | Calibration completed | Passed\n",
          "oa:suffix": "\n2026-05-03 | Maintenance visit | Sensor cleaned"
        }
      }
    },
    {
      "@id": "https://example.org/ck/relation/csv",
      "@type": "ex:EvidenceRelation",
      "ex:relationType": "supports_that_station_recorded_value",
